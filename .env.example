# .env.example — 환경변수 견본 (커밋 O)
# 사용법: 이 파일을 .env로 복사한 뒤 각자의 실제 값으로 채운다.
#   cp .env.example .env
# .env는 .gitignore 처리되어 커밋되지 않는다. spring-dotenv가 실행 시 자동 로드한다.

# --- OAuth2 소셜 로그인 시크릿 (각자 개발자 콘솔에서 발급) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- JWT 서명 키 (openssl rand -base64 64 로 생성한 긴 랜덤 문자열) ---
JWT_SECRET=

# --- (선택) JWT 만료 시간 ms — 미설정 시 application.yml 기본값 사용 ---
# JWT_ACCESS_EXPIRE_MS=1800000
# JWT_REFRESH_EXPIRE_MS=1209600000

# --- AI 비전 분석 (OpenAI) ---
# 미설정 시 앱은 기동하되 AI 분석 요청만 실패한다.
OPENAI_API_KEY=

# --- (선택) 비전 모델 — 미설정 시 gpt-4o-mini 사용 ---
# 비전과 Structured Outputs(json_schema strict)를 모두 지원하는 모델이어야 한다.
# OPENAI_VISION_MODEL=gpt-4o-mini

# --- (선택) 장소 검색 (카카오 로컬) ---
# 미설정 시 KAKAO_CLIENT_ID(카카오 앱 REST 키)를 그대로 쓴다.
# 카카오 개발자 콘솔에서 해당 앱의 "카카오맵" 사용 설정이 켜져 있어야 한다.
# KAKAO_REST_API_KEY=

# --- (선택) Redis 접속 — 미설정 시 localhost:6379 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- (선택) 로그인 성공 후 프론트 리다이렉트 주소 ---
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback
