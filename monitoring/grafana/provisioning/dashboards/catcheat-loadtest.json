{
    "uid": "catcheat-loadtest",
    "title": "CatchEat 부하테스트",
    "tags": ["catcheat", "k6", "loadtest"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "refresh": "5s",
    "time": { "from": "now-15m", "to": "now" },
    "templating": {
        "list": [
            {
                "name": "rate_window",
                "label": "rate 범위",
                "type": "custom",
                "query": "30s,1m,2m,5m",
                "current": { "text": "30s", "value": "30s" },
                "options": [
                    { "text": "30s", "value": "30s", "selected": true },
                    { "text": "1m", "value": "1m", "selected": false },
                    { "text": "2m", "value": "2m", "selected": false },
                    { "text": "5m", "value": "5m", "selected": false }
                ]
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "row",
            "title": "한눈에 — 화면 시간 범위의 최대값 (캡쳐용)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
            "collapsed": false
        },
        {
            "id": 2,
            "type": "stat",
            "title": "최대 VU",
            "description": "이 구간에서 k6가 올린 가상 사용자 수의 최대. 테스트가 안 돌면 비어 있는 게 정상",
            "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [{ "refId": "A", "expr": "k6_vus", "legendFormat": "VU" }],
            "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } }, "overrides": [] },
            "options": { "reduceOptions": { "calcs": ["max"] }, "graphMode": "area" }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "처리량 최대 (RPS)",
            "description": "서버가 실제로 처리한 초당 요청 수의 최대. Counter라 rate()로 감싼다. VU를 올려도 이 값이 안 오르면 그 지점이 용량 한계",
            "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_server_requests_seconds_count{job=\"catcheat-backend\"}[$rate_window]))",
                    "legendFormat": "RPS"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
            "options": { "reduceOptions": { "calcs": ["max"] }, "graphMode": "area" }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "서버 p95 최대",
            "description": "히스토그램 버킷으로 계산한 95번째 백분위수 응답시간의 최대. 평균 대신 이걸 본다",
            "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"catcheat-backend\"}[$rate_window])))",
                    "legendFormat": "p95"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "decimals": 3,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 0.3 },
                            { "color": "red", "value": 0.5 }
                        ]
                    },
                    "color": { "mode": "thresholds" }
                },
                "overrides": []
            },
            "options": { "reduceOptions": { "calcs": ["max"] }, "graphMode": "area" }
        },
        {
            "id": 5,
            "type": "stat",
            "title": "에러율 최대 (k6)",
            "description": "k6가 실패로 판정한 요청 비율의 최대. 1%를 넘으면 성능 이전에 기능이 깨진 것",
            "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [{ "refId": "A", "expr": "k6_http_req_failed_rate", "legendFormat": "실패율" }],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "decimals": 2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "red", "value": 0.01 }
                        ]
                    },
                    "color": { "mode": "thresholds" }
                },
                "overrides": []
            },
            "options": { "reduceOptions": { "calcs": ["max"] }, "graphMode": "area" }
        },
        {
            "id": 6,
            "type": "stat",
            "title": "DB 커넥션 대기 최대",
            "description": "한 번이라도 0보다 컸으면 커넥션을 못 얻어 줄을 선 것 = 커넥션풀 병목. 부하테스트에서 가장 자주 걸리는 지점이고, 이 숫자가 이 대시보드의 핵심 증빙이다",
            "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [{ "refId": "A", "expr": "hikaricp_connections_pending", "legendFormat": "대기" }],
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "red", "value": 1 }
                        ]
                    },
                    "color": { "mode": "thresholds" }
                },
                "overrides": []
            },
            "options": { "reduceOptions": { "calcs": ["max"] }, "graphMode": "area" }
        },
        {
            "id": 7,
            "type": "stat",
            "title": "CPU 최대",
            "description": "구간 최대. 이게 낮은데 응답이 느리면 CPU가 아니라 '기다림'(DB·락·외부IO)이 병목이다 — 서버 사양을 올려도 안 빨라진다",
            "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [{ "refId": "A", "expr": "process_cpu_usage", "legendFormat": "프로세스" }],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "decimals": 1,
                    "max": 1,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "yellow", "value": 0.7 },
                            { "color": "red", "value": 0.9 }
                        ]
                    },
                    "color": { "mode": "thresholds" }
                },
                "overrides": []
            },
            "options": { "reduceOptions": { "calcs": ["max"] }, "graphMode": "area" }
        },

        {
            "id": 10,
            "type": "row",
            "title": "부하 곡선 — 무릎점 찾기",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
            "collapsed": false
        },
        {
            "id": 11,
            "type": "timeseries",
            "title": "VU 대비 처리량",
            "description": "VU는 오르는데 RPS가 평평해지기 시작하는 지점이 무릎점 = 우리 서버의 실제 용량",
            "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                { "refId": "A", "expr": "k6_vus", "legendFormat": "VU (k6)" },
                {
                    "refId": "B",
                    "expr": "sum(rate(http_server_requests_seconds_count{job=\"catcheat-backend\"}[$rate_window]))",
                    "legendFormat": "RPS (서버)"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "short", "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" } },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 12,
            "type": "timeseries",
            "title": "응답시간 — 클라이언트(k6) vs 서버",
            "description": "k6 p95가 서버 p95보다 훨씬 크면 그 차이는 네트워크·부하기 한계다. 서버를 고쳐도 안 줄어든다",
            "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                { "refId": "A", "expr": "k6_http_req_duration_p95 / 1000", "legendFormat": "k6 p95" },
                { "refId": "B", "expr": "k6_http_req_duration_p99 / 1000", "legendFormat": "k6 p99" },
                {
                    "refId": "C",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"catcheat-backend\"}[$rate_window])))",
                    "legendFormat": "서버 p95"
                },
                {
                    "refId": "D",
                    "expr": "k6_http_req_blocked_p95 / 1000",
                    "legendFormat": "blocked p95 (부하기 한계 신호)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "decimals": 3,
                    "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
                },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },

        {
            "id": 20,
            "type": "row",
            "title": "병목 진단",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
            "collapsed": false
        },
        {
            "id": 21,
            "type": "timeseries",
            "title": "DB 커넥션풀 (HikariCP)",
            "description": "★ 이 패널이 커넥션풀 병목의 직접 증거다. '사용 중'이 '풀 크기'에 닿고 '대기'가 0보다 커지면 병목. // 순간값 게이지를 5초마다 찍으면 톱니처럼 요동쳐 포화가 안 보인다. 그래서 rate 범위만큼의 최대(대기·사용 중)와 최소(노는 중)로 감싸 실제 한계선을 그린다",
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "max_over_time(hikaricp_connections_active[$rate_window])",
                    "legendFormat": "사용 중 (최대)"
                },
                {
                    "refId": "B",
                    "expr": "min_over_time(hikaricp_connections_idle[$rate_window])",
                    "legendFormat": "노는 중 (최소)"
                },
                {
                    "refId": "C",
                    "expr": "max_over_time(hikaricp_connections_pending[$rate_window])",
                    "legendFormat": "대기 ★ (최대)"
                },
                { "refId": "D", "expr": "hikaricp_connections_max", "legendFormat": "풀 크기" }
            ],
            "fieldConfig": {
                "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 22,
            "type": "timeseries",
            "title": "톰캣 스레드",
            "description": "busy가 max에 붙으면 스레드 고갈. 대개 DB 대기나 외부 IO의 결과지 원인이 아니다",
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                { "refId": "A", "expr": "tomcat_threads_busy_threads", "legendFormat": "일하는 중" },
                { "refId": "B", "expr": "tomcat_threads_current_threads", "legendFormat": "생성됨" },
                { "refId": "C", "expr": "tomcat_threads_config_max_threads", "legendFormat": "최대" }
            ],
            "fieldConfig": {
                "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 23,
            "type": "timeseries",
            "title": "CPU",
            "description": "80% 이상이면 CPU 병목. 30% 이하인데 느리면 어딘가에서 기다리는 중",
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                { "refId": "A", "expr": "process_cpu_usage", "legendFormat": "우리 프로세스" },
                { "refId": "B", "expr": "system_cpu_usage", "legendFormat": "머신 전체" }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "max": 1,
                    "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
                },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 24,
            "type": "timeseries",
            "title": "경로별 p95 — 어느 API가 느린가",
            "description": "uri 라벨로 쪼갠 응답시간. 범인을 특정하는 패널",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"catcheat-backend\", uri!=\"UNKNOWN\"}[$rate_window])))",
                    "legendFormat": "{{uri}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "decimals": 3,
                    "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
                },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 25,
            "type": "timeseries",
            "title": "JVM 힙 · GC",
            "description": "힙이 톱니 없이 우상향하면 누수 의심. GC 할당률이 치솟으면 요청당 객체를 너무 많이 만든다는 뜻",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
            "datasource": { "type": "prometheus", "uid": "catcheat-prometheus" },
            "targets": [
                { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "힙 사용" },
                { "refId": "B", "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "힙 최대" },
                {
                    "refId": "C",
                    "expr": "rate(jvm_gc_memory_allocated_bytes_total[$rate_window])",
                    "legendFormat": "초당 할당량"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "bytes", "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" } },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        }
    ]
}
